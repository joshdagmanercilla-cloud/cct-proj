# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL database for persistent accounts (use a managed database in production).
DATABASE_URL="postgresql://postgres:password@localhost:5432/cct"

# Use a unique random value of at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Set to production when deployed behind HTTPS to enable Secure auth cookies.
NODE_ENV="development"
