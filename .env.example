# GEMINI_API_KEY: Optional server-side Gemini integration key.
# Never expose it with a VITE_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Supabase client settings used by the Vite browser app.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-supabase-anon-or-publishable-key>"

# Server settings. Keep SUPABASE_SERVICE_ROLE_KEY secret and server-only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-supabase-anon-or-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# Optional; default is 5 MiB.
MAX_VERIFICATION_UPLOAD_BYTES="5242880"
APP_URL="http://localhost:3000"
