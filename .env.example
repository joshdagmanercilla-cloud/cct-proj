# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep this server-side; never expose it through a VITE_ variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Supabase client configuration used by the Vite browser app.
# The anon/publishable key is expected to be public; protect all exposed data with RLS.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-supabase-anon-or-publishable-key>"

# Server-side Supabase configuration. These values are not Vite variables.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-supabase-anon-or-publishable-key>"
# Secret: never commit or expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# Optional maximum verification upload size in bytes (default: 5242880 / 5 MiB).
MAX_VERIFICATION_UPLOAD_BYTES="5242880"

# Optional public app URL used by application integrations.
APP_URL="http://localhost:3000"
